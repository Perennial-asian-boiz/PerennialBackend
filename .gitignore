# Environment variables — never commit credentials
.env
.env.*
!.env.example

# Fetcher JSON output (written pre-DB by the consensus_watchlist pipeline)
development/database/local_data/*
!development/database/local_data/.gitkeep

# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
.pytest_cache/
.mypy_cache/
*.egg-info/
build/
dist/

# IDE
.idea/
.vscode/

# OS junk
.DS_Store
Thumbs.db

# Database dumps
*.dump
*.sql.gz

# Logs
*.log

# Data directory
data/

# Optional local agent tooling (not required by the backend)
/.local-tools/
/.agents/skills/archify/
/.agents/skills/openrig-*/
/.openrig/
/.codex/plugins/openrig-core/
/.codex/rules/openrig.rules
/.claude/settings.local.json
/AGENTS.md
/CLAUDE.md
/.agents/skills/
/.codex/plugins/
# Also ignore a project-local venv selected through a symlink.
.venv
