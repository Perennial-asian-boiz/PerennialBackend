# Copy this file to .env in THIS directory and fill in your real keys.
#   cp .env.example .env       (Mac/Linux)
#   copy .env.example .env     (Windows)
#
# Local development only: set PERENNIAL_ENV=local to read this file.
# Deployed processes receive settings from environment variables.

# Congress trades — fmp.py (Senate, and the optional FMP House page)
FMP_API_KEY=your_fmp_key_here

# Database Congress collection (optional; defaults shown). House trades come
# from the Clerk of the House (no key); "fmp" uses FMP's 20-row House page.
# Senate trades come from FMP's free page, accumulated into history.
# CONGRESS_HOUSE_SOURCE=house_clerk
# CONGRESS_INCLUDE_FMP_SENATE=true

# Insider trades — insider.py and the database collector (collect_insider)
FINNHUB_API_KEY=your_finnhub_key_here

# Short interest — short_interest.py needs NO key.
# It uses the Nasdaq public quote endpoint, which serves the same
# FINRA-sourced numbers without OAuth. The FINRA_CLIENT_ID /
# FINRA_CLIENT_SECRET pair from earlier drafts is no longer used.

# Sentiment — YouTube (Cohen)
YOUTUBE_API_KEY=your_youtube_key_here

# Sentiment — X/Twitter (Cohen)
TWITTER_BEARER_TOKEN=your_twitter_token_here

# Event summaries, ingestion-time only (ADR-005) — Claude
ANTHROPIC_API_KEY=your_anthropic_key_here

# Database (everyone)
# Supabase session pooler (IPv4). Replace project reference and pooler hostname.
# Keep [YOUR-PASSWORD] literally; put the raw password in the separate variable.
# SQLAlchemy safely handles @, :, / and other password characters.
# DATABASE_URL below is administrative. FastAPI uses API_DATABASE_URL instead.
DATABASE_URL=postgresql://postgres.PROJECT_REF:[YOUR-PASSWORD]@POOLER_HOST:5432/postgres?sslmode=require
SUPABASE_DB_PASSWORD=""
# Dedicated NOBYPASSRLS login with membership in perennial_api. URL-encode the
# runtime password; never reuse migration/admin credentials here.
API_DATABASE_URL=postgresql://perennial_app.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Signup, resend and password-reset email links return here, then go to Sign in
# (never Dashboard). The path ends in /auth/confirm, optionally after a prefix
# (GitHub Pages: https://perennial-asian-boiz.github.io/PerennialFrontEnd/auth/confirm).
# Add this exact URL to Supabase Authentication > URL Configuration > Redirect URLs,
# or Supabase sends users to its Site URL instead. See OPERATIONS.md.
AUTH_EMAIL_REDIRECT_URL=http://127.0.0.1:5173/auth/confirm
# Docker remains an isolated development/test option, not a fake-account mode:
# DATABASE_URL=postgresql+psycopg://perennial:perennial@localhost:5433/perennial

# HTTP API. Authentication always uses real Supabase; no development OTP bypass.
APP_ENV=development

# Comma-separated browser origins allowed to call the API. In production this
# must be set to the deployed frontend origin(s); never use '*'.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Configure SMTP in the Supabase dashboard, not in this file. The temporary
# development sender is Gmail SMTP; do not commit or share its App Password.
# Resend needs a verified sending domain before replacing this temporary setup.
# Enable email confirmation, set OTP length 6 and expiration 900 seconds.
# Confirm signup uses {{ .ConfirmationURL }} (link). Magic Link (login) and
# Recovery templates use {{ .Token }} (six-digit code). Keep email confirmation ON.
# No Supabase service-role key or Resend secret belongs in browser VITE_* vars.

# Dashboard API: use the copied frontend fixture until the ranking pipeline
# provides enriched company metadata. Use "publication" for real published data.
DASHBOARD_DATA_MODE=fixture

# Tests only: a disposable, loopback PostgreSQL server with "test" in the
# database name. Tests create and drop their own perennial_test_<random> database.
# TEST_DATABASE_URL=postgresql+psycopg://perennial:perennial@localhost:5433/perennial_test

# SEC EDGAR: fundamentals, summaries, and company size (public float) in
# consensus.py and, with MARKET_CAP_ADAPTER=sec_public_float, the database
# pipeline. SEC requires a contact email in the User-Agent.
SEC_USER_AGENT=Perennial research you@example.com
# MARKET_CAP_ADAPTER=sec_public_float   (unset: the database pipeline keeps FMP)
