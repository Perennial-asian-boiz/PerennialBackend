# Copy this file to .env in THIS directory and fill in your real keys.
#   cp .env.example .env       (Mac/Linux)
#   copy .env.example .env     (Windows)
#
# Location matters: every module loads credentials from
# development/backend/.env via paths.ENV_PATH. Nothing else is read.

# Congress trades — fmp.py, and the market-cap lookup in consensus.py
FMP_API_KEY=your_fmp_key_here

# Insider trades — insider.py
FINNHUB_API_KEY=your_finnhub_key_here

# Short interest — short_interest.py needs NO key.
# It uses the Nasdaq public quote endpoint, which serves the same
# FINRA-sourced numbers without OAuth. The FINRA_CLIENT_ID /
# FINRA_CLIENT_SECRET pair from earlier drafts is no longer used.

# Sentiment — YouTube (Cohen)
YOUTUBE_API_KEY=your_youtube_key_here

# Sentiment — X/Twitter (Cohen)
TWITTER_BEARER_TOKEN=your_twitter_token_here

# Event summaries, ingestion-time only (ADR-005) — Claude
ANTHROPIC_API_KEY=your_anthropic_key_here

# Database (everyone)
# Matches the local Docker Compose database (development/database/docker-compose.yml),
# whose development-only credentials are not secrets. For a shared database, put
# its real URL in .env only. See development/database/README.md.
DATABASE_URL=postgresql+psycopg://perennial:perennial@localhost:5433/perennial

# HTTP API. Keep development while testing OTP locally; production never
# returns a verification code and must send it through an email provider.
APP_ENV=development

# Comma-separated browser origins allowed to call the API. In production this
# must be set to the deployed frontend origin(s); never use '*'.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Session lifetime. Password changes and logout revoke sessions immediately.
SESSION_TTL_DAYS=7

# OTP delivery. Resend sends real email, including when APP_ENV=development.
# Set both secrets below before testing signup/login; missing configuration
# returns 503 rather than claiming that an email was sent.
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=
# Example sender after domain verification:
# EMAIL_FROM=Perennial <noreply@your-verified-domain.example>
# To test ONLY your Resend account's own email before verifying a domain:
# EMAIL_FROM=Perennial <onboarding@resend.dev>
# Explicit offline-only alternative: EMAIL_PROVIDER=development. It returns
# development_code to the frontend and is forbidden outside APP_ENV=development.

# Dashboard API: use the copied frontend fixture until the ranking pipeline
# provides enriched company metadata. Use "publication" for real published data.
DASHBOARD_DATA_MODE=fixture

# Tests only: a disposable, loopback PostgreSQL server with "test" in the
# database name. Tests create and drop their own perennial_test_<random> database.
# TEST_DATABASE_URL=postgresql+psycopg://perennial:perennial@localhost:5433/perennial_test
