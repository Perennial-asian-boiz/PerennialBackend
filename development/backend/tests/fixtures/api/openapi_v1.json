{
  "paths": {
    "/v1/market-status": {
      "get": {
        "description": "Whether the US stock market is in regular hours, and its next open and\nclose (S1-11). No database; cached until at most the next transition.",
        "operationId": "get_market_status_v1_market_status_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "examples": {
                  "closed": {
                    "summary": "Closed (a Saturday)",
                    "value": {
                      "as_of": "2026-10-31T16:00:00Z",
                      "early_close": false,
                      "exchange": "XNYS",
                      "is_open": false,
                      "label": "Market Closed",
                      "next_close": "2026-11-02T16:00:00-05:00",
                      "next_open": "2026-11-02T09:30:00-05:00",
                      "note": "Regular hours, 9:30 a.m.\u20134:00 p.m. ET. Some brokers allow extended-hours trading.",
                      "session": "closed"
                    }
                  },
                  "open": {
                    "summary": "Open (a Monday, 10:00 a.m. ET)",
                    "value": {
                      "as_of": "2026-10-26T14:00:00Z",
                      "early_close": false,
                      "exchange": "XNYS",
                      "is_open": true,
                      "label": "Market Open",
                      "next_close": "2026-10-26T16:00:00-04:00",
                      "next_open": "2026-10-27T09:30:00-04:00",
                      "note": "Regular hours, 9:30 a.m.\u20134:00 p.m. ET. Some brokers allow extended-hours trading.",
                      "session": "regular"
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/MarketStatusResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "rate_limited: too many requests from this client",
            "headers": {
              "Retry-After": {
                "description": "Whole seconds until the next request is allowed",
                "schema": {
                  "type": "integer"
                }
              }
            }
          }
        },
        "summary": "Get Market Status"
      }
    },
    "/v1/securities/{symbol}": {
      "get": {
        "description": "A security by ticker or alias, with its entry in the current publication.",
        "operationId": "get_security_v1_securities__symbol__get",
        "parameters": [
          {
            "in": "path",
            "name": "symbol",
            "required": true,
            "schema": {
              "title": "Symbol",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SecurityResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "No current publication, or unknown security"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "invalid_request"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "rate_limited: too many requests from this client",
            "headers": {
              "Retry-After": {
                "description": "Whole seconds until the next request is allowed",
                "schema": {
                  "type": "integer"
                }
              }
            }
          }
        },
        "summary": "Get Security"
      }
    },
    "/v1/watchlist": {
      "get": {
        "description": "The current production publication's watchlist and its envelope.",
        "operationId": "get_watchlist_v1_watchlist_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WatchlistResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "304": {
            "description": "Not modified (If-None-Match matched)"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "No current publication"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "rate_limited: too many requests from this client",
            "headers": {
              "Retry-After": {
                "description": "Whole seconds until the next request is allowed",
                "schema": {
                  "type": "integer"
                }
              }
            }
          }
        },
        "summary": "Get Watchlist"
      }
    }
  },
  "schemas": {
    "ErrorBody": {
      "properties": {
        "code": {
          "description": "no_current_publication, unknown_security, invalid_request or rate_limited",
          "title": "Code",
          "type": "string"
        },
        "detail": {
          "title": "Detail",
          "type": "string"
        }
      },
      "required": [
        "detail",
        "code"
      ],
      "title": "ErrorBody",
      "type": "object"
    },
    "MarketStatusResponse": {
      "properties": {
        "as_of": {
          "description": "When this was computed: ISO 8601, UTC",
          "title": "As Of",
          "type": "string"
        },
        "early_close": {
          "description": "True when the session next_close belongs to closes early",
          "title": "Early Close",
          "type": "boolean"
        },
        "exchange": {
          "description": "XNYS: the New York Stock Exchange calendar",
          "title": "Exchange",
          "type": "string"
        },
        "is_open": {
          "description": "True during regular hours only",
          "title": "Is Open",
          "type": "boolean"
        },
        "label": {
          "description": "Market Open or Market Closed",
          "title": "Label",
          "type": "string"
        },
        "next_close": {
          "description": "While open, today's close; while closed, the next session's close: ISO 8601, America/New_York offset",
          "title": "Next Close",
          "type": "string"
        },
        "next_open": {
          "description": "The next session's open: ISO 8601, America/New_York offset",
          "title": "Next Open",
          "type": "string"
        },
        "note": {
          "description": "The regular hours, and that extended hours exist",
          "title": "Note",
          "type": "string"
        },
        "session": {
          "description": "regular or closed",
          "title": "Session",
          "type": "string"
        }
      },
      "required": [
        "exchange",
        "is_open",
        "session",
        "label",
        "note",
        "as_of",
        "next_open",
        "next_close",
        "early_close"
      ],
      "title": "MarketStatusResponse",
      "type": "object"
    },
    "Publication": {
      "properties": {
        "congress_history_gaps": {
          "title": "Congress History Gaps",
          "type": "integer"
        },
        "created_at": {
          "description": "ISO 8601, UTC",
          "title": "Created At",
          "type": "string"
        },
        "degraded": {
          "description": "True when the publication has a degraded event: a reused source, Congress history gaps or a market-cap fallback; stale_sources may be empty",
          "title": "Degraded",
          "type": "boolean"
        },
        "demo": {
          "description": "True only for a demo publication",
          "title": "Demo",
          "type": "boolean"
        },
        "id": {
          "title": "Id",
          "type": "integer"
        },
        "market_caps_unavailable": {
          "description": "Records warning market_cap_unavailable, across all buckets",
          "title": "Market Caps Unavailable",
          "type": "integer"
        },
        "ranking_version": {
          "title": "Ranking Version",
          "type": "string"
        },
        "source_as_of": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "description": "Observation date per watchlist source",
          "title": "Source As Of",
          "type": "object"
        },
        "stale_sources": {
          "description": "Reused sources, by source",
          "items": {
            "$ref": "#/components/schemas/StaleSource"
          },
          "title": "Stale Sources",
          "type": "array"
        }
      },
      "required": [
        "id",
        "created_at",
        "ranking_version",
        "demo",
        "degraded",
        "stale_sources",
        "market_caps_unavailable",
        "congress_history_gaps",
        "source_as_of"
      ],
      "title": "Publication",
      "type": "object"
    },
    "Security": {
      "properties": {
        "country": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Country"
        },
        "currency": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Currency"
        },
        "exchange": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Exchange"
        },
        "id": {
          "title": "Id",
          "type": "integer"
        },
        "industry": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Industry"
        },
        "is_active": {
          "title": "Is Active",
          "type": "boolean"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Name"
        },
        "sector": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Sector"
        },
        "security_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Security Type"
        },
        "symbol": {
          "title": "Symbol",
          "type": "string"
        }
      },
      "required": [
        "id",
        "symbol",
        "name",
        "security_type",
        "exchange",
        "currency",
        "country",
        "is_active",
        "sector",
        "industry"
      ],
      "title": "Security",
      "type": "object"
    },
    "SecurityCurrent": {
      "properties": {
        "entry": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "description": "The security's record in the current publication, or null",
          "title": "Entry"
        },
        "publication": {
          "anyOf": [
            {
              "$ref": "#/components/schemas/Publication"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "publication",
        "entry"
      ],
      "title": "SecurityCurrent",
      "type": "object"
    },
    "SecurityResponse": {
      "properties": {
        "api_version": {
          "examples": [
            "v1"
          ],
          "title": "Api Version",
          "type": "string"
        },
        "current": {
          "$ref": "#/components/schemas/SecurityCurrent"
        },
        "security": {
          "$ref": "#/components/schemas/Security"
        }
      },
      "required": [
        "api_version",
        "security",
        "current"
      ],
      "title": "SecurityResponse",
      "type": "object"
    },
    "StaleSource": {
      "properties": {
        "age_seconds": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "Its age when this publication was made",
          "title": "Age Seconds"
        },
        "collected_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "When the reused batch was collected",
          "title": "Collected At"
        },
        "source": {
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "source",
        "collected_at",
        "age_seconds"
      ],
      "title": "StaleSource",
      "type": "object"
    },
    "WatchlistResponse": {
      "properties": {
        "api_version": {
          "examples": [
            "v1"
          ],
          "title": "Api Version",
          "type": "string"
        },
        "publication": {
          "$ref": "#/components/schemas/Publication"
        },
        "watchlist": {
          "additionalProperties": true,
          "description": "publications.output, verbatim",
          "title": "Watchlist",
          "type": "object"
        }
      },
      "required": [
        "api_version",
        "publication",
        "watchlist"
      ],
      "title": "WatchlistResponse",
      "type": "object"
    }
  }
}
