          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "No current publication, or unknown security"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "invalid_request"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "rate_limited: too many requests from this client",
            "headers": {
              "Retry-After": {
                "description": "Whole seconds until the next request is allowed",
                "schema": {
                  "type": "integer"
                }
              }
            }
          }
        },
        "summary": "Get Security"
      }
    },
    "/v1/securities/{symbol}/score": {
      "get": {
        "description": "A security's current Confidence Score, its breakdown and why it is recommended.\n\n200 with score.status \"unavailable\" when the current scores batch has no row\nfor it; 404 only for an unknown ticker.",
        "operationId": "get_score_v1_securities__symbol__score_get",
        "parameters": [
          {
            "in": "path",
            "name": "symbol",
            "required": true,
            "schema": {
              "title": "Symbol",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScoreResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "304": {
            "description": "Not modified (If-None-Match matched)"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "unknown_security"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
